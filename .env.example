DATABASE_URL="file:./dev.db"
SESSION_SECRET=CHANGE_ME
ADMIN_EMAIL="braiden@enpfitouts.com.au"
ADMIN_PASSWORD=CHANGE_ME
TEAM_EMAIL="team@drfitout.com.au"
TEAM_PASSWORD=CHANGE_ME

# Claude: the brain inside the app (Ask assistant, Dashboard assistant, AI concept fit, concept package import).
ANTHROPIC_API_KEY=
# Optional: everyday model (default claude-sonnet-5-5) and the model that reads floor plans / packages (defaults to CLAUDE_MODEL).
CLAUDE_MODEL=
CLAUDE_VISION_MODEL=

# Estimator login (created on first start if missing)
ESTIMATOR_EMAIL="justin@enpfitouts.com.au"
ESTIMATOR_NAME="Justin"
ESTIMATOR_PASSWORD=CHANGE_ME

# Accounts login (created on first start if missing)
ACCOUNTS_EMAIL="accounts@enpfitouts.com.au"
ACCOUNTS_PASSWORD=CHANGE_ME

# Xero (from developer.xero.com, Web app). Never commit real values.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI="https://crm-production-b8fa.up.railway.app/xero/callback"
MONTHLY_TARGET=

# Grok: user-like access from outside to add data (docs/GROK_API.md). 24+ random characters.
GROK_ADMIN_KEY=
# Optional Claude connector for claude.ai / Claude Code (docs/CLAUDE_CONNECTOR.md). 24+ random characters.
CLAUDE_CONNECTOR_KEY=
