DATABASE_URL="file:./dev.db"
SESSION_SECRET=CHANGE_ME
ADMIN_EMAIL="braiden@enpfitouts.com.au"
ADMIN_PASSWORD=CHANGE_ME
TEAM_EMAIL="team@drfitout.com.au"
TEAM_PASSWORD=CHANGE_ME

# Optional AI for the assistants. Grok: set XAI_API_KEY (and AI_MODEL if you want a different Grok model)
XAI_API_KEY=
AI_MODEL=
# Or OpenAI instead: OPENAI_API_KEY=

# Estimator login (created on first start if missing)
ESTIMATOR_EMAIL="justin@enpfitouts.com.au"
ESTIMATOR_NAME="Justin"
ESTIMATOR_PASSWORD=CHANGE_ME

# Accounts login (created on first start if missing)
ACCOUNTS_EMAIL="accounts@enpfitouts.com.au"
ACCOUNTS_PASSWORD=CHANGE_ME

# Xero (from developer.xero.com, Web app). Never commit real values.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI="https://crm-production-b8fa.up.railway.app/xero/callback"
MONTHLY_TARGET=

# Grok working on the CRM from outside (docs/GROK_FULL_ACCESS.md). 24+ random characters.
GROK_ADMIN_KEY=
# Model that reads floor plans for the AI concept fit (must accept images). Defaults to AI_MODEL.
AI_VISION_MODEL=
