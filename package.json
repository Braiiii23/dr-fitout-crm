{
  "name": "dr-fitout-crm",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3100",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3100",
    "db:push": "prisma db push",
    "db:seed": "tsx -r dotenv/config prisma/seed.ts",
